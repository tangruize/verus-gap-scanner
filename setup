#!/usr/bin/env python3
import subprocess
import sys
import venv
from pathlib import Path

root = Path(__file__).resolve().parent
if sys.version_info < (3, 11):
    print("setup error: Python 3.11 or newer is required.", file=sys.stderr)
    raise SystemExit(2)
if any(arg in {"--help", "-h"} for arg in sys.argv[1:]):
    sys.path.insert(0, str(root / "src"))
    from verus_gap.setup_verus import main
    raise SystemExit(main())

environment = root / ".venv"
python = environment / "bin/python"
try:
    if not python.is_file():
        print("Creating a local Python environment...", flush=True)
        venv.EnvBuilder(with_pip=True).create(environment)
    pip_check = subprocess.run(
        [str(python), "-m", "pip", "--version"],
        capture_output=True, text=True,
    )
    if pip_check.returncode:
        print("Repairing pip in the local Python environment...", flush=True)
        subprocess.run(
            [str(python), "-m", "ensurepip", "--upgrade", "--default-pip"],
            check=True,
        )
    print("Installing the declared scanner dependencies...", flush=True)
    subprocess.run(
        [str(python), "-m", "pip", "install", "--quiet", "-e", str(root)],
        check=True,
    )
except (OSError, subprocess.CalledProcessError) as error:
    print(f"setup error: Cannot prepare the local Python environment: {error}", file=sys.stderr)
    raise SystemExit(2)
raise SystemExit(subprocess.run(
    [str(python), "-m", "verus_gap.setup_verus", *sys.argv[1:]],
).returncode)
